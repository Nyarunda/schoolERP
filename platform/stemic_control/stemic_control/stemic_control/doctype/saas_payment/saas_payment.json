{
  "doctype": "DocType",
  "name": "SaaS Payment",
  "module": "Stemic Control",
  "custom": 0,
  "istable": 0,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "invoice",
    "tenant",
    "school_name",
    "cb_head",
    "payment_date",
    "amount",
    "currency",
    "mode",
    "reference",
    "notes",
    "amended_from",
    "reference_key"
  ],
  "fields": [
    {
      "fieldname": "invoice",
      "fieldtype": "Link",
      "label": "Invoice",
      "options": "SaaS Invoice",
      "reqd": 1
    },
    {
      "fieldname": "tenant",
      "fieldtype": "Link",
      "label": "School",
      "options": "SaaS Tenant",
      "fetch_from": "invoice.tenant",
      "read_only": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "school_name",
      "fieldtype": "Data",
      "label": "School Name",
      "fetch_from": "invoice.school_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "cb_head",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "payment_date",
      "fieldtype": "Date",
      "label": "Payment Date",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Amount",
      "options": "currency",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency",
      "fetch_from": "invoice.currency",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "mode",
      "fieldtype": "Select",
      "label": "Paid By",
      "options": "M-Pesa\nBank Transfer\nCheque\nCash\nCard\nOther",
      "default": "M-Pesa",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "reference",
      "fieldtype": "Data",
      "label": "Reference",
      "reqd": 1,
      "description": "M-Pesa code, bank reference or cheque number. Each can be used once."
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "SaaS Payment",
      "read_only": 1,
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "reference_key",
      "fieldtype": "Data",
      "label": "Unique Reference Key",
      "unique": 1,
      "hidden": 1,
      "read_only": 1,
      "no_copy": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "print": 1
    },
    {
      "role": "Stemic Platform Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "print": 1
    },
    {
      "role": "Stemic Agent",
      "read": 1,
      "report": 1,
      "print": 1
    }
  ],
  "creation": "2026-10-26 18:00:00.000000",
  "modified": "2026-10-26 18:00:00.000000",
  "modified_by": "Administrator",
  "owner": "Administrator",
  "autoname": "SPAY-.YYYY.-.#####",
  "naming_rule": "Expression (old style)",
  "is_submittable": 1,
  "title_field": "school_name",
  "search_fields": "school_name,reference",
  "sort_field": "payment_date",
  "default_print_format": "Stemic Receipt"
}
