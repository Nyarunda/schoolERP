#!/usr/bin/python3 -I
"""Serve schools' custom domains: the Control Center's routes -> nginx (run as root by stemic-domains.service).

    stemic-domains-sync <bench path>

Reads <bench>/config/stemic-domains.json ({"domains": {hostname: site}}, written by stemic_control.domains), keeps
each hostname that is valid, points to a real site folder and is covered by a certificate in /etc/ssl/cloudflare
(<name>.pem with <name>.key), and writes /etc/nginx/conf.d/stemic-domains.conf: the map from hostname to site folder
($stemic_site, used by snippets/stemic-site.conf) and one server block per certificate. nginx is reloaded only when
the file changed and `nginx -t` passes; otherwise the previous file is put back. What happened to each hostname is
written to /var/lib/stemic/domains-status.json, which the Control Center shows.

The routes file is written by the bench's user, so nothing from it reaches the nginx configuration unchecked.
For testing: STEMIC_NGINX_OUT, STEMIC_DOMAINS_STATUS, STEMIC_CERTS, STEMIC_NGINX_SNIPPET, STEMIC_NGINX (the nginx
command, e.g. "nginx -p /tmp/x -c /tmp/x/nginx.conf"), STEMIC_HTTP_PORT, STEMIC_HTTPS_PORT; STEMIC_NO_RELOAD=1.
"""

import datetime
import glob
import json
import os
import re
import shlex
import subprocess
import sys

HOST = re.compile(r"^(?=.{4,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$")
SITE = re.compile(r"^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$")
OUT = os.environ.get("STEMIC_NGINX_OUT", "/etc/nginx/conf.d/stemic-domains.conf")
STATUS = os.environ.get("STEMIC_DOMAINS_STATUS", "/var/lib/stemic/domains-status.json")
CERTS = os.environ.get("STEMIC_CERTS", "/etc/ssl/cloudflare")
NGINX = shlex.split(os.environ.get("STEMIC_NGINX", "nginx"))
HTTP, HTTPS = os.environ.get("STEMIC_HTTP_PORT", "80"), os.environ.get("STEMIC_HTTPS_PORT", "443")
SNIPPET = os.environ.get("STEMIC_NGINX_SNIPPET", "/etc/nginx/snippets/stemic-site.conf")
MESSAGES = {"invalid": "Not a valid hostname", "bad_site": "The school's site folder was not found on this server",
            "no_certificate": "No certificate in {certs} covers it", "nginx_failed": "nginx -t rejected the configuration"}


def load(bench):
    try:
        with open(os.path.join(bench, "config", "stemic-domains.json")) as f:
            data = json.load(f).get("domains") or {}
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError, AttributeError):
        return {}


def site_ok(bench, site):
    path = os.path.join(bench, "sites", site)
    return bool(SITE.match(site)) and ".." not in site and os.path.isdir(path) and not os.path.islink(path) \
        and os.path.isfile(os.path.join(path, "site_config.json"))


def certificates():
    """[(name, pem, key)] that can be used now."""
    out = []
    for pem in sorted(glob.glob(os.path.join(CERTS, "*.pem"))):
        key = pem[:-4] + ".key"
        if os.path.isfile(key) and subprocess.run(["openssl", "x509", "-in", pem, "-noout", "-checkend", "0"],
                                                  capture_output=True, check=False).returncode == 0:
            out.append((os.path.basename(pem)[:-4], pem, key))
    return out


def covers(pem, host):
    r = subprocess.run(["openssl", "x509", "-in", pem, "-noout", "-checkhost", host], capture_output=True, text=True,
                       check=False)
    return r.returncode == 0 and "does match" in r.stdout


def plan(bench, routes):
    """(served {host: (site, cert)}, status {host: {...}})"""
    served, status, certs = {}, {}, certificates()
    for host, site in sorted(routes.items()):
        host, site = str(host).lower(), str(site).lower()
        if not HOST.match(host):
            status[host[:253]] = {"site": None, "certificate": None, "problem": "invalid"}
            continue
        if not site_ok(bench, site):
            status[host] = {"site": site if SITE.match(site) else None, "certificate": None, "problem": "bad_site"}
            continue
        cert = next((c for c in certs if covers(c[1], host)), None)
        status[host] = {"site": site, "certificate": cert[0] if cert else None, "problem": None if cert else "no_certificate"}
        if cert:
            served[host] = (site, cert)
    return served, status


def render(served):
    lines = ["# Generated by stemic-domains-sync from the Control Center's custom domains: do not edit.",
             "# $stemic_site is the site folder for the request: the Host itself, or a school's own domain's site.",
             "map $host $stemic_site {", "\tdefault $host;"]
    lines += [f"\t{host} {site};" for host, (site, _) in sorted(served.items())]
    lines.append("}")
    if served:
        lines += ["", "server {", f"\tlisten {HTTP};", f"\tlisten [::]:{HTTP};", f"\tserver_name {' '.join(sorted(served))};",
                  "\treturn 301 https://$host$request_uri;", "}"]
    by_cert = {}
    for host, (_, cert) in served.items():
        by_cert.setdefault(cert, []).append(host)
    for (name, pem, key), hosts in sorted(by_cert.items()):
        lines += ["", f"# certificate {name}", "server {", f"\tlisten {HTTPS} ssl http2;",
                  f"\tlisten [::]:{HTTPS} ssl http2;",
                  f"\tserver_name {' '.join(sorted(hosts))};", f"\tssl_certificate {pem};", f"\tssl_certificate_key {key};",
                  "\tssl_protocols TLSv1.2 TLSv1.3;", "\tssl_session_cache shared:stemic_ssl:10m;",
                  f"\tinclude {SNIPPET};", "}"]
    return "\n".join(lines) + "\n"


def write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def save_status(status, changed, error=None):
    for entry in status.values():
        entry["message"] = MESSAGES[entry["problem"]].format(certs=CERTS) if entry.get("problem") else None
    write(STATUS, json.dumps({"synced_on": datetime.datetime.now().isoformat(timespec="seconds"), "changed": changed,
                              "error": error, "domains": status}, indent=1, sort_keys=True))


def main(bench):
    served, status = plan(bench, load(bench))
    text = render(served)
    try:
        with open(OUT) as f:
            before = f.read()
    except OSError:
        before = None
    if text == before:
        save_status(status, False)
        return 0
    write(OUT, text)
    test = subprocess.run([*NGINX, "-t"], capture_output=True, text=True, check=False)
    if test.returncode != 0:
        if before is None:
            os.remove(OUT)
        else:
            write(OUT, before)
        for host in served:
            status[host]["problem"] = "nginx_failed"
        save_status(status, False, test.stderr[-2000:])
        print(test.stderr, file=sys.stderr)
        return 1
    if os.environ.get("STEMIC_NO_RELOAD") != "1":
        subprocess.run(["systemctl", "reload", "nginx"], check=True)
    save_status(status, True)
    print(f"stemic-domains-sync: {len(served)} domain(s) served, {len(status) - len(served)} not")
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 2 or not os.path.isdir(os.path.join(sys.argv[1], "sites")):
        sys.exit(__doc__.split("\n\n")[1])
    sys.exit(main(os.path.realpath(sys.argv[1])))
