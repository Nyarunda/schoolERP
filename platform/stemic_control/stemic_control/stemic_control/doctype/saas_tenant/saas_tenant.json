{
  "doctype": "DocType",
  "name": "SaaS Tenant",
  "module": "Stemic Control",
  "custom": 0,
  "istable": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "field:slug",
  "naming_rule": "By fieldname",
  "engine": "InnoDB",
  "field_order": [
    "overview_html",
    "school_section",
    "school_name",
    "county",
    "cost_center",
    "branch_name",
    "school_group",
    "slug",
    "admin_email",
    "contact_phone",
    "school_column",
    "agent",
    "subscription",
    "status",
    "sb_site",
    "canonical_site",
    "database_name",
    "welcome_sent_on",
    "platform_domain",
    "primary_domain",
    "site_column",
    "site_admin_password",
    "approval_section",
    "approved_by",
    "approved_on",
    "approval_column",
    "approval_note",
    "notes_section",
    "notes",
    "erp_customer"
  ],
  "fields": [
    {
      "fieldname": "overview_html",
      "fieldtype": "HTML",
      "label": "Overview"
    },
    {
      "fieldname": "school_section",
      "fieldtype": "Section Break",
      "label": "School"
    },
    {
      "fieldtype": "Data",
      "fieldname": "school_name",
      "label": "School Name",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "county",
      "label": "County",
      "fieldtype": "Select",
      "options": "\nBaringo\nBomet\nBungoma\nBusia\nElgeyo-Marakwet\nEmbu\nGarissa\nHoma Bay\nIsiolo\nKajiado\nKakamega\nKericho\nKiambu\nKilifi\nKirinyaga\nKisii\nKisumu\nKitui\nKwale\nLaikipia\nLamu\nMachakos\nMakueni\nMandera\nMarsabit\nMeru\nMigori\nMombasa\nMurang'a\nNairobi\nNakuru\nNandi\nNarok\nNyamira\nNyandarua\nNyeri\nSamburu\nSiaya\nTaita-Taveta\nTana River\nTharaka-Nithi\nTrans Nzoia\nTurkana\nUasin Gishu\nVihiga\nWajir\nWest Pokot",
      "in_standard_filter": 1,
      "description": "Where the school is (for growth by county)."
    },
    {
      "fieldname": "cost_center",
      "label": "Cost Center",
      "fieldtype": "Data",
      "read_only": 1,
      "no_copy": 1,
      "description": "This school's cost center in Stemic's books."
    },
    {
      "fieldname": "branch_name",
      "label": "Branch",
      "fieldtype": "Data",
      "depends_on": "school_group",
      "description": "e.g. Kisii Campus"
    },
    {
      "fieldname": "school_group",
      "label": "School Group",
      "fieldtype": "Link",
      "options": "SaaS School Group",
      "in_standard_filter": 1,
      "description": "Branches of one school, each its own site, are grouped here."
    },
    {
      "fieldtype": "Data",
      "fieldname": "slug",
      "label": "Tenant Slug",
      "reqd": 1,
      "unique": 1,
      "description": "Names the school's site and subdomain; cannot be changed once created.",
      "set_only_once": 1
    },
    {
      "fieldtype": "Data",
      "fieldname": "admin_email",
      "label": "School Admin Email",
      "options": "Email",
      "reqd": 1
    },
    {
      "fieldname": "contact_phone",
      "fieldtype": "Data",
      "label": "Contact Phone",
      "options": "Phone",
      "description": "For SMS from Stemic (invoices, receipts, reminders), when SMS is on in Stemic Settings."
    },
    {
      "fieldname": "school_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldtype": "Link",
      "fieldname": "agent",
      "label": "Sales Agent",
      "options": "SaaS Agent",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldtype": "Link",
      "fieldname": "subscription",
      "label": "Subscription",
      "options": "SaaS Subscription",
      "read_only": 1
    },
    {
      "fieldtype": "Select",
      "fieldname": "status",
      "label": "Status",
      "options": "Draft\nPending Approval\nApproved\nRejected\nPending\nProvisioning\nActive\nSuspended\nFailed\nDeleted",
      "default": "Draft",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "sb_site",
      "fieldtype": "Section Break",
      "label": "Site",
      "collapsible": 1,
      "depends_on": "eval:doc.canonical_site"
    },
    {
      "fieldtype": "Data",
      "fieldname": "canonical_site",
      "label": "Site",
      "read_only": 1,
      "unique": 1
    },
    {
      "fieldname": "database_name",
      "fieldtype": "Data",
      "label": "Database",
      "read_only": 1,
      "description": "sch_<slug> for sites created by the provisioner; older sites keep the name Frappe gave them."
    },
    {
      "fieldname": "welcome_sent_on",
      "fieldtype": "Datetime",
      "label": "Welcome Email Sent",
      "read_only": 1,
      "no_copy": 1,
      "description": "When the school's contact was last emailed their address and a link to set their password."
    },
    {
      "fieldname": "platform_domain",
      "fieldtype": "Data",
      "label": "Platform Domain",
      "read_only": 1,
      "description": "Which of Stemic's domains the school's address is on (<school>.<this domain>)."
    },
    {
      "fieldtype": "Data",
      "fieldname": "primary_domain",
      "label": "Primary Domain",
      "read_only": 1
    },
    {
      "fieldname": "site_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "site_admin_password",
      "fieldtype": "Password",
      "label": "Site Administrator Password",
      "read_only": 1,
      "no_copy": 1,
      "print_hide": 1
    },
    {
      "fieldname": "approval_section",
      "fieldtype": "Section Break",
      "label": "Approval",
      "collapsible": 1,
      "depends_on": "eval:doc.approved_on || doc.status == 'Rejected'"
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Link",
      "label": "Approved By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": 1
    },
    {
      "fieldname": "approval_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "approval_note",
      "fieldtype": "Small Text",
      "label": "Approval / Rejection Note",
      "read_only": 1
    },
    {
      "fieldname": "notes_section",
      "fieldtype": "Section Break",
      "label": "Notes",
      "collapsible": 1,
      "collapsible_depends_on": "eval:doc.notes && doc.notes != 'Demo data (stemic_control.demo)'"
    },
    {
      "fieldtype": "Small Text",
      "fieldname": "notes",
      "label": "Notes"
    },
    {
      "fieldname": "erp_customer",
      "fieldtype": "Data",
      "label": "Customer (accounts)",
      "read_only": 1,
      "no_copy": 1,
      "description": "The ERPNext Customer this school is billed as."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1
    },
    {
      "role": "Stemic Platform Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1
    },
    {
      "role": "Stemic Agent",
      "read": 1,
      "report": 1
    }
  ],
  "creation": "2026-10-25 20:00:00.000000",
  "modified": "2026-11-22 17:00:00.000000",
  "modified_by": "Administrator",
  "owner": "Administrator",
  "title_field": "school_name",
  "show_title_field_in_link": 1
}
