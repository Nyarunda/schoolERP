{
  "doctype": "DocType",
  "name": "Stemic Settings",
  "module": "Stemic Control",
  "custom": 0,
  "istable": 0,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "setup_tab",
    "setup_html",
    "platform_tab",
    "platform_domain",
    "dns_over_https",
    "cb_platform",
