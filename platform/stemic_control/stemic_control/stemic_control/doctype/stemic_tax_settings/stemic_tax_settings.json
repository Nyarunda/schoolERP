      "label": "Seller Name",
      "reqd": 1
    },
    {
      "fieldname": "seller_pin",
      "fieldtype": "Data",
      "label": "Seller Pin",
      "reqd": 1
    },
    {
      "fieldname": "branch_id",
      "fieldtype": "Data",
      "label": "Branch Id"
    },
    {
      "fieldname": "integration_mode",
      "fieldtype": "Select",
      "label": "Integration Mode",
      "options": "Manual\nCertified Integrator\nOSCU\nVSCU"
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "0"
    },
    {
      "fieldname": "vat_rate",
      "fieldtype": "Percent",
      "label": "VAT Rate",
      "default": "16",
      "depends_on": "eval:doc.tax_treatment=='Standard Rated'"
