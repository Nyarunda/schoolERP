{
  "doctype": "DocType",
  "name": "SaaS Credit Note",
  "module": "Stemic Control",
  "custom": 0,
  "engine": "InnoDB",
  "is_submittable": 1,
  "autoname": "SCN-.YYYY.-.#####",
  "naming_rule": "Expression (old style)",
  "track_changes": 1,
  "title_field": "school_name",
  "sort_field": "credit_date",
  "sort_order": "DESC",
  "field_order": [
    "invoice",
    "tenant",
    "school_name",
    "credit_date",
    "cb1",
    "amount",
    "currency",
    "reason",
    "notes",
    "refund_section",
    "refund",
    "refund_amount",
    "refund_mode",
    "refund_reference",
    "books_section",
    "return_invoice",
    "refund_entry",
    "cb2",
    "tax_credit_status",
    "kra_credit_reference",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "invoice",
      "label": "Invoice",
      "fieldtype": "Link",
      "options": "SaaS Invoice",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "A submitted subscription invoice."
    },
    {
      "fieldname": "tenant",
      "label": "School",
      "fieldtype": "Link",
      "options": "SaaS Tenant",
      "read_only": 1,
      "fetch_from": "invoice.tenant",
      "in_standard_filter": 1
    },
    {
      "fieldname": "school_name",
      "label": "School Name",
      "fieldtype": "Data",
      "read_only": 1,
      "fetch_from": "invoice.school_name",
      "in_list_view": 1
    },
    {
      "fieldname": "credit_date",
      "label": "Date",
      "fieldtype": "Date",
      "reqd": 1,
      "default": "Today",
      "in_list_view": 1
    },
    {
      "fieldname": "cb1",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "amount",
      "label": "Credit Amount (incl. VAT)",
      "fieldtype": "Currency",
      "reqd": 1,
      "in_list_view": 1,
      "options": "currency",
      "description": "Reduces what the school owes on the invoice."
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "read_only": 1,
      "fetch_from": "invoice.currency"
    },
    {
      "fieldname": "reason",
      "label": "Reason",
      "fieldtype": "Select",
      "options": "Billing error\nDiscount after invoicing\nService problem\nSchool left\nDuplicate invoice\nOther",
      "reqd": 1
    },
    {
      "fieldname": "notes",
      "label": "Notes",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "refund_section",
      "label": "Refund",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "refund",
      "label": "Refund money to the school",
      "fieldtype": "Check",
      "description": "Only money the school paid beyond what it now owes can be refunded."
    },
    {
      "fieldname": "refund_amount",
      "label": "Refund Amount",
      "fieldtype": "Currency",
      "options": "currency",
      "depends_on": "refund",
      "mandatory_depends_on": "refund"
    },
    {
      "fieldname": "refund_mode",
      "label": "Refunded By",
      "fieldtype": "Select",
      "options": "M-Pesa\nBank Transfer\nCheque\nCash",
      "depends_on": "refund",
      "mandatory_depends_on": "refund"
    },
    {
      "fieldname": "refund_reference",
      "label": "Refund Reference",
      "fieldtype": "Data",
      "depends_on": "refund",
      "mandatory_depends_on": "refund",
      "description": "M-Pesa code or bank reference."
    },
    {
      "fieldname": "books_section",
      "label": "Books and tax",
      "fieldtype": "Section Break",
      "collapsible": 1
    },
    {
      "fieldname": "return_invoice",
      "label": "Credit Note (Sales Invoice return)",
      "fieldtype": "Data",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "refund_entry",
      "label": "Refund Payment Entry",
      "fieldtype": "Data",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "cb2",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "tax_credit_status",
      "label": "KRA Credit Note",
      "fieldtype": "Select",
      "options": "Not needed\nNeeded\nDone",
      "default": "Not needed",
      "read_only": 1,
      "no_copy": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "kra_credit_reference",
      "label": "KRA Credit Note Number",
      "fieldtype": "Data",
      "allow_on_submit": 1,
      "no_copy": 1,
      "depends_on": "eval:doc.tax_credit_status!='Not needed'",
      "description": "The tax invoice is with KRA: raise the credit note in eTIMS and enter its number here."
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "SaaS Credit Note",
      "read_only": 1,
      "no_copy": 1,
      "print_hide": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Stemic Platform Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Stemic Agent",
      "read": 1
    }
  ],
  "creation": "2026-11-22 15:00:00.000000",
  "modified": "2026-11-22 15:00:00.000000",
  "modified_by": "Administrator",
  "owner": "Administrator",
  "description": "Credit part or all of a subscription invoice, and refund money to the school. Posted as a Sales Invoice return (and a refund Payment Entry)."
}
