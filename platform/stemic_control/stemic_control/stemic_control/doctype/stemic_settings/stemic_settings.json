    "seller_pin",
    "seller_address",
    "cb_billing",
    "currency",
    "billing_months",
    "payment_terms_days",
    "renewal_notice_days",
    "payment_instructions",
    "commission_tab",
    "commission_basis",
    "communications_tab",
    "notify_schools_by_email",
    "notify_schools_by_sms",
    "cb_comms",
    "notify_welcome",
    "notify_invoice",
    "notify_payment",
    "notify_overdue",
    "notify_license",
    "notify_status",
    "sms_gateway_section",
    "sms_url",
    "sms_http_method",
    "sms_body_format",
    "sms_recipient_param",
    "sms_message_param",
    "sms_number_format",
    "sms_country_code",
    "cb_sms",
    "sms_sender_param",
    "sms_sender_id",
    "sms_api_key_param",
    "sms_api_key_in",
    "sms_api_key_prefix",
    "sms_api_key",
    "sms_parameters",
    "sms_success_section",
    "sms_success_field",
    "sms_success_values",
    "cb_sms_success",
    "sms_success_text",
    "sms_test_number",
    "accounting_tab",
    "post_to_accounts",
    "accounting_company",
    "accounting_html"
  ],
  "fields": [
    {
      "fieldname": "setup_tab",
      "fieldtype": "Tab Break",
      "label": "Setup Check"
    },
    {
      "fieldname": "setup_html",
      "fieldtype": "HTML"
    },
    {
      "fieldname": "platform_tab",
      "fieldtype": "Tab Break",
      "label": "Platform"
    },
    {
      "fieldname": "platform_domain",
      "fieldtype": "Data",
      "label": "Platform Domain",
      "description": "Schools' default addresses are <school>.<this domain>, e.g. stemicschools.com."
    },
    {
      "fieldname": "dns_over_https",
      "fieldtype": "Data",
      "label": "DNS Lookup Service",
      "description": "Used to check custom-domain ownership (DNS-over-HTTPS JSON). Default: Cloudflare."
    },
    {
      "fieldname": "cb_platform",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "local_provisioner",
      "fieldtype": "Check",
      "label": "Create school sites on this server",
      "description": "Turns queued sites into real ones on this bench. Builds them as the limited database account (stemic_provisioner) whose password is in the server's secrets file, /etc/stemic/secrets.env (README: Secrets)."
    },
    {
      "fieldname": "site_domain",
      "fieldtype": "Data",
      "label": "Local Site Suffix",
      "description": "Sites created here are named <school>.<this>, e.g. localhost on a development machine."
    },
    {
      "fieldname": "site_apps",
      "fieldtype": "Small Text",
      "label": "Apps on Each School Site",
      "description": "One per line, in install order."
    },
    {
      "fieldname": "bench_path",
      "fieldtype": "Data",
      "label": "Bench Path",
      "description": "Leave blank to use this bench."
    },
    {
      "fieldname": "billing_tab",
      "fieldtype": "Tab Break",
      "label": "Billing"
    },
    {
      "fieldname": "seller_name",
      "fieldtype": "Data",
      "label": "Billing Name",
      "description": "Shown as the seller on invoices and receipts."
    },
    {
      "fieldname": "seller_pin",
      "fieldtype": "Data",
      "label": "KRA PIN"
    },
    {
      "fieldname": "seller_address",
      "fieldtype": "Small Text",
      "label": "Address and Contacts"
    },
    {
      "fieldname": "cb_billing",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency",
      "default": "KES"
    },
    {
      "fieldname": "billing_months",
      "fieldtype": "Int",
      "label": "Months per Invoice",
      "default": "12",
      "description": "The period a new subscription invoice covers unless you choose otherwise."
    },
    {
      "fieldname": "payment_terms_days",
      "fieldtype": "Int",
      "label": "Days to Pay",
      "default": "14"
    },
    {
      "fieldname": "renewal_notice_days",
      "fieldtype": "Int",
      "label": "Invoice Renewals This Many Days Early",
      "default": "30",
      "description": "A renewal invoice is raised automatically this long before a subscription ends. 0 = never automatically."
    },
    {
      "fieldname": "payment_instructions",
      "fieldtype": "Small Text",
      "label": "Payment Instructions",
      "description": "Printed on invoices. {invoice} and {amount} are filled in, e.g. 'Pay via M-Pesa Paybill 123456, Account {invoice}'."
    },
    {
      "fieldname": "commission_tab",
      "fieldtype": "Tab Break",
      "label": "Commissions"
    },
    {
      "fieldname": "commission_basis",
      "fieldtype": "Select",
      "label": "Agents Earn Commission On",
      "options": "Every payment\nFirst payment only",
      "default": "Every payment",
      "description": "Each agent's rate is on their agent record."
    },
    {
      "fieldname": "communications_tab",
      "fieldtype": "Tab Break",
      "label": "Communications"
    },
    {
      "fieldname": "notify_schools_by_email",
      "fieldtype": "Check",
      "label": "Email schools",
      "default": "1",
      "description": "From the default outgoing Email Account, to each school's contact email."
    },
    {
      "fieldname": "notify_schools_by_sms",
      "fieldtype": "Check",
      "label": "SMS schools",
      "default": "0",
      "description": "Also by SMS to each school's contact phone, through the gateway below. Links and license keys go by email only."
    },
    {
      "fieldname": "cb_comms",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "notify_welcome",
      "fieldtype": "Check",
      "label": "Site ready (welcome)",
      "default": "1"
    },
    {
      "fieldname": "notify_invoice",
      "fieldtype": "Check",
      "label": "Invoice issued",
      "default": "1"
    },
    {
      "fieldname": "notify_payment",
      "fieldtype": "Check",
      "label": "Payment received",
      "default": "1"
    },
    {
      "fieldname": "notify_overdue",
      "fieldtype": "Check",
      "label": "Invoice overdue",
      "default": "1"
    },
    {
      "fieldname": "notify_license",
      "fieldtype": "Check",
      "label": "License issued",
      "default": "1"
    },
    {
      "fieldname": "notify_status",
      "fieldtype": "Check",
      "label": "Suspended / resumed",
      "default": "1"
    },
    {
      "fieldname": "sms_gateway_section",
      "fieldtype": "Section Break",
      "label": "SMS Gateway",
      "depends_on": "eval:doc.notify_schools_by_sms",
      "description": "Any HTTP SMS provider, from its API documentation (Africa's Talking: POST, Form, username in Other Parameters, apiKey as a header, success field SMSMessageData.Recipients.0.statusCode = 100,101,102)."
    },
    {
      "fieldname": "sms_url",
      "fieldtype": "Data",
      "label": "Send URL",
      "options": "URL",
      "mandatory_depends_on": "eval:doc.notify_schools_by_sms"
    },
    {
      "fieldname": "sms_http_method",
      "fieldtype": "Select",
      "label": "Method",
      "options": "POST\nGET",
      "default": "POST"
    },
    {
      "fieldname": "sms_body_format",
      "fieldtype": "Select",
      "label": "Body Format",
      "options": "JSON\nForm",
      "default": "JSON",
      "depends_on": "eval:doc.notify_schools_by_sms && doc.sms_http_method==\"POST\""
    },
    {
      "fieldname": "sms_recipient_param",
      "fieldtype": "Data",
      "label": "Phone Number Parameter",
      "mandatory_depends_on": "eval:doc.notify_schools_by_sms"
    },
    {
      "fieldname": "sms_message_param",
      "fieldtype": "Data",
      "label": "Message Parameter",
      "mandatory_depends_on": "eval:doc.notify_schools_by_sms"
    },
    {
      "fieldname": "sms_number_format",
      "fieldtype": "Select",
      "label": "Number Format",
      "options": "2547XXXXXXXX\n+2547XXXXXXXX\n07XXXXXXXX",
      "default": "2547XXXXXXXX"
    },
    {
      "fieldname": "sms_country_code",
      "fieldtype": "Data",
      "label": "Country Code",
      "default": "254"
    },
    {
      "fieldname": "cb_sms",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "sms_sender_param",
      "fieldtype": "Data",
      "label": "Sender ID Parameter"
    },
    {
      "fieldname": "sms_sender_id",
      "fieldtype": "Data",
      "label": "Sender ID"
    },
    {
      "fieldname": "sms_api_key_param",
      "fieldtype": "Data",
      "label": "API Key Parameter"
    },
    {
      "fieldname": "sms_api_key_in",
      "fieldtype": "Select",
      "label": "Send API Key In",
      "options": "Body\nHeader",
      "default": "Body"
    },
    {
      "fieldname": "sms_api_key_prefix",
      "fieldtype": "Data",
      "label": "API Key Prefix"
    },
    {
      "fieldname": "sms_api_key",
      "fieldtype": "Password",
      "label": "API Key",
      "length": 255
    },
    {
      "fieldname": "sms_parameters",
      "fieldtype": "Small Text",
      "label": "Other Parameters",
      "description": "One per line: name=value. Start a line with header: for an HTTP header, e.g. header:Accept=application/json"
    },
    {
      "fieldname": "sms_success_section",
      "fieldtype": "Section Break",
      "label": "How to Tell an SMS Was Accepted",
      "depends_on": "eval:doc.notify_schools_by_sms"
    },
    {
      "fieldname": "sms_success_field",
      "fieldtype": "Data",
      "label": "Success Field",
      "description": "Dotted path in the JSON reply, e.g. responses.0.response-code"
    },
    {
      "fieldname": "sms_success_values",
      "fieldtype": "Data",
      "label": "Success Values",
      "description": "Comma-separated, e.g. 200"
    },
    {
      "fieldname": "cb_sms_success",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "sms_success_text",
      "fieldtype": "Data",
      "label": "Or: Reply Contains"
    },
    {
      "fieldname": "sms_test_number",
      "fieldtype": "Data",
      "label": "Test Phone Number",
      "description": "Save, then Send Test SMS."
    },
    {
      "fieldname": "accounting_tab",
      "fieldtype": "Tab Break",
      "label": "Accounting"
    },
    {
      "fieldname": "post_to_accounts",
      "fieldtype": "Check",
      "label": "Post to accounts",
      "default": "0",
      "description": "Post each subscription invoice, payment and agent commission to ERPNext on this site, as Sales Invoices, Payment Entries and Journal Entries. Needs ERPNext installed here and Set Up Accounts run."
    },
    {
      "fieldname": "accounting_company",
      "fieldtype": "Data",
      "label": "Company",
      "depends_on": "post_to_accounts",
      "mandatory_depends_on": "post_to_accounts",
      "description": "The ERPNext company that keeps Stemic's books, e.g. Stemic Schools Ltd."
    },
    {
      "fieldname": "accounting_html",
      "fieldtype": "HTML",
      "label": "Accounts used"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Stemic Platform Admin",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "creation": "2026-10-26 18:00:00.000000",
  "modified": "2026-10-26 18:00:00.000000",
  "modified_by": "Administrator",
  "owner": "Administrator",
  "issingle": 1
}
