{
  "doctype": "DocType",
  "name": "SaaS Subscription",
  "module": "Stemic Control",
  "custom": 0,
  "istable": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "SUB-.#####",
  "naming_rule": "Expression (old style)",
  "engine": "InnoDB",
  "field_order": [
    "summary_html",
    "details_section",
    "tenant",
    "school_name",
    "plan",
    "plan_price",
    "agent",
    "cb_period",
    "status",
    "starts_on",
    "ends_on",
    "external_payment_ref",
    "exception_section",
    "billing_exception",
    "exception_approved_by",
    "exception_approved_on",
    "exception_column",
    "exception_note"
  ],
  "fields": [
    {
      "fieldtype": "HTML",
      "fieldname": "summary_html"
    },
    {
      "fieldtype": "Section Break",
      "fieldname": "details_section",
      "label": "Details"
    },
    {
      "fieldtype": "Link",
      "fieldname": "tenant",
      "label": "School ID",
      "options": "SaaS Tenant",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldtype": "Data",
      "fieldname": "school_name",
      "label": "School",
      "fetch_from": "tenant.school_name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldtype": "Link",
      "fieldname": "plan",
      "label": "Plan",
      "options": "SaaS Plan",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldtype": "Currency",
      "fieldname": "plan_price",
      "label": "Monthly Price",
      "fetch_from": "plan.monthly_price",
      "read_only": 1
    },
    {
      "fieldtype": "Link",
      "fieldname": "agent",
      "label": "Sales Agent",
      "options": "SaaS Agent"
    },
    {
      "fieldtype": "Column Break",
      "fieldname": "cb_period"
    },
    {
      "fieldtype": "Select",
      "fieldname": "status",
      "label": "Status",
      "options": "Trial\nActive\nPast Due\nGrace\nSuspended\nCancelled",
      "default": "Trial",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Changed with the Actions menu."
    },
    {
      "fieldtype": "Date",
      "fieldname": "starts_on",
      "label": "Starts On",
      "reqd": 1
    },
    {
      "fieldtype": "Date",
      "fieldname": "ends_on",
      "label": "Ends On",
      "in_list_view": 1,
      "description": "The license key stops working 14 days after this date unless renewed."
    },
    {
      "fieldtype": "Data",
      "fieldname": "external_payment_ref",
      "label": "Payment Reference",
      "read_only": 1,
      "description": "Set when the subscription is activated or renewed (M-Pesa code, bank ref or invoice)."
    },
    {
      "fieldname": "exception_section",
      "fieldtype": "Section Break",
      "label": "Site Without Payment",
      "collapsible": 1,
      "description": "An operator-approved free trial or internal / demo school may be given a site before paying."
    },
    {
      "fieldname": "billing_exception",
      "fieldtype": "Select",
      "label": "Exception",
      "options": "\nFree Trial\nInternal / Demo",
      "read_only": 1
    },
    {
      "fieldname": "exception_approved_by",
      "fieldtype": "Link",
      "label": "Approved By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "exception_approved_on",
      "fieldtype": "Datetime",
      "label": "Approved On",
      "read_only": 1
    },
    {
      "fieldname": "exception_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "exception_note",
      "fieldtype": "Small Text",
      "label": "Reason",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1
    },
    {
      "role": "Stemic Platform Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1
    },
    {
      "role": "Stemic Agent",
      "read": 1,
      "report": 1
    }
  ],
  "creation": "2026-10-25 20:00:00.000000",
  "modified": "2026-10-26 12:30:00.000000",
  "modified_by": "Administrator",
  "owner": "Administrator",
  "title_field": "school_name",
  "search_fields": "school_name,plan,status",
  "sort_field": "modified"
}
