{
  "doctype": "DocType",
  "name": "SaaS Tenant",
  "module": "Stemic Control",
  "custom": 0,
  "istable": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "format:ST-{#######}",
  "engine": "InnoDB",
  "field_order": [
    "school_name",
    "slug",
    "admin_email",
    "canonical_site",
    "status",
    "primary_domain",
    "agent",
    "subscription",
    "notes"
  ],
  "fields": [
    {
      "fieldtype": "Data",
      "fieldname": "school_name",
      "label": "School Name",
      "reqd": 1
    },
    {
      "fieldtype": "Data",
      "fieldname": "slug",
      "label": "Tenant Slug",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldtype": "Data",
      "fieldname": "admin_email",
      "label": "School Admin Email",
      "options": "Email",
      "reqd": 1
    },
    {
      "fieldtype": "Data",
      "fieldname": "canonical_site",
      "label": "Frappe Site",
      "read_only": 1,
      "unique": 1
    },
    {
      "fieldtype": "Select",
      "fieldname": "status",
      "label": "Status",
      "options": "Draft\nPending\nProvisioning\nActive\nSuspended\nFailed",
      "default": "Draft",
      "read_only": 1
    },
    {
      "fieldtype": "Data",
      "fieldname": "primary_domain",
      "label": "Primary Domain",
      "read_only": 1
    },
    {
      "fieldtype": "Link",
      "fieldname": "agent",
      "label": "Agent",
      "options": "SaaS Agent"
    },
    {
      "fieldtype": "Link",
      "fieldname": "subscription",
      "label": "Subscription",
      "options": "SaaS Subscription",
      "read_only": 1
    },
    {
      "fieldtype": "Small Text",
      "fieldname": "notes",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1
    },
    {
      "role": "Stemic Platform Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1
    }
  ]
}
