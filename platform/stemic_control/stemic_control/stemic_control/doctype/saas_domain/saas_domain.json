{
  "doctype": "DocType",
  "name": "SaaS Domain",
  "module": "Stemic Control",
  "custom": 0,
  "istable": 0,
  "is_submittable": 0,
  "track_changes": 1,
  "autoname": "format:ST-{#######}",
  "engine": "InnoDB",
  "field_order": [
    "tenant",
    "hostname",
    "domain_type",
    "status",
    "verification_token",
    "verified_on",
    "is_primary"
  ],
  "fields": [
    {
      "fieldtype": "Link",
      "fieldname": "tenant",
      "label": "Tenant",
      "options": "SaaS Tenant",
      "reqd": 1
    },
    {
      "fieldtype": "Data",
      "fieldname": "hostname",
      "label": "Hostname",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldtype": "Select",
      "fieldname": "domain_type",
      "label": "Domain Type",
      "options": "Stemic Subdomain\nCustom Domain",
      "reqd": 1
    },
    {
      "fieldtype": "Select",
      "fieldname": "status",
      "label": "Status",
      "options": "Pending Verification\nVerified\nActive\nDisabled",
      "default": "Pending Verification",
      "read_only": 1
    },
    {
      "fieldtype": "Data",
      "fieldname": "verification_token",
      "label": "Verification Token",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldtype": "Datetime",
      "fieldname": "verified_on",
      "label": "Verified On",
      "read_only": 1
    },
    {
      "fieldtype": "Check",
      "fieldname": "is_primary",
      "label": "Primary Domain",
      "default": 0,
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1
    },
    {
      "role": "Stemic Platform Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1
    }
  ]
}
